# Private Python AI service. Never expose these values to the browser.
COHORT_AI_INTERNAL_KEY=
SUPABASE_URL=
SUPABASE_PUBLISHABLE_KEY=
SUPABASE_SERVICE_ROLE_KEY=

AI_DOCUMENTS_BUCKET=university-documents

# Service runtime
STUDENT_AI_TITLE=Cohort Student AI
STUDENT_AI_VERSION=0.4.0
STUDENT_AI_HOST=127.0.0.1
STUDENT_AI_PORT=8001
STUDENT_AI_RELOAD=false
STUDENT_AI_MAX_MESSAGE_CHARS=12000
STUDENT_AI_MAX_HISTORY_MESSAGES=20
STUDENT_AI_MAX_CONTEXT_ITEMS=12

# Gemini 3.5 Flash-Lite
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash-lite
GEMINI_API_VERSION=v1
GEMINI_THINKING_LEVEL=minimal
GEMINI_MAX_OUTPUT_TOKENS=8192

# Local-only Gemini playground defaults
PLAYGROUND_SYSTEM_PROMPT=
PLAYGROUND_GEMINI_MODEL=gemini-3.5-flash-lite
PLAYGROUND_GEMINI_INPUT_USD_PER_MILLION=0
PLAYGROUND_GEMINI_OUTPUT_USD_PER_MILLION=0