# Keep this service private; never expose these values to the browser.
COHORT_AI_INTERNAL_KEY=replace-with-a-long-random-secret

# Configure at least one provider. OpenAI is preferred when both are configured.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-6-luna
OPENAI_REASONING_EFFORT=medium

GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.8-flash
GEMINI_THINKING_LEVEL=medium
GEMINI_MAX_OUTPUT_TOKENS=8192
