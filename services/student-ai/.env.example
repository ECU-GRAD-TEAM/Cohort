# Private Python AI service. Never expose these values to the browser.
COHORT_AI_INTERNAL_KEY=replace-with-a-long-random-secret

# Service runtime
STUDENT_AI_TITLE=Cohort Student AI
STUDENT_AI_VERSION=0.3.0
STUDENT_AI_HOST=127.0.0.1
STUDENT_AI_PORT=8001
STUDENT_AI_RELOAD=false
STUDENT_AI_PROVIDER=auto
STUDENT_AI_MAX_MESSAGE_CHARS=12000
STUDENT_AI_MAX_HISTORY_MESSAGES=20
STUDENT_AI_MAX_CONTEXT_ITEMS=12

# Provider credentials and defaults
OPENAI_API_KEY=
OPENAI_MODEL=gpt-6-luna
OPENAI_TIMEOUT_SECONDS=60
OPENAI_MAX_RETRIES=2
OPENAI_REASONING_EFFORT=medium
OPENAI_TEXT_VERBOSITY=medium
OPENAI_TEMPERATURE=0.7

GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.8-flash
GEMINI_API_VERSION=v1
GEMINI_THINKING_LEVEL=medium
GEMINI_TEMPERATURE=0.7
GEMINI_MAX_OUTPUT_TOKENS=8192

# Local-only playground defaults (overridable per experiment in its UI)
PLAYGROUND_SYSTEM_PROMPT=You are a helpful, accurate, patient assistant. Be clear about uncertainty.
PLAYGROUND_OPENAI_MODEL=
PLAYGROUND_GEMINI_MODEL=
PLAYGROUND_TEMPERATURE=0.7
PLAYGROUND_OPENAI_INPUT_USD_PER_MILLION=0
PLAYGROUND_OPENAI_OUTPUT_USD_PER_MILLION=0
PLAYGROUND_GEMINI_INPUT_USD_PER_MILLION=0
PLAYGROUND_GEMINI_OUTPUT_USD_PER_MILLION=0
