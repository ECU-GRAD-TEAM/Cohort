}

datasource db {
  provider = "postgresql"
  schemas  = ["auth", "public"]
}

model auth_users {
  id                 String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  email              String?
  raw_app_meta_data  Json?     @default("{}")
  raw_user_meta_data Json?     @default("{}")
  created_at         DateTime? @default(now()) @db.Timestamptz(6)
  users              users?

  @@map("users")
  @@schema("auth")
}

